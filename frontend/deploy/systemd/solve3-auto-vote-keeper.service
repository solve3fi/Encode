[Unit]
Description=Solve3 admin auto-vote wallets keeper
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/solve3/auto-vote-keeper.env
RuntimeDirectory=solve3-auto-vote-keeper
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n -E 75 /run/solve3-auto-vote-keeper/lock /usr/bin/docker run --rm --read-only --network host --security-opt no-new-privileges --cap-drop ALL --tmpfs /tmp:rw,noexec,nosuid,size=16m --env-file /etc/solve3/auto-vote-keeper.env -v /srv/solve3/scripts:/app/scripts:ro -v /srv/solve3/src/configs/vesolve.json:/app/src/configs/vesolve.json:ro -v solve3-production_solve3_data:/app/data:rw --entrypoint /usr/local/bin/bun solve3-frontend:local /app/scripts/auto-vote-keeper.mjs
SuccessExitStatus=75

# Unlike the epoch keeper, this one WRITES back per-wallet vote status
# (lastVotedEpoch/lastError) into /app/data — the SAME named Docker volume
# (solve3-production_solve3_data, created by compose.yml's app service; run
# `docker volume ls` to confirm the name if the compose project is ever
# renamed) the running app container mounts, not a host bind path — hence
# the data mount is rw while everything else stays read-only. The wallets'
# own secret keys never leave that volume in plaintext; they're encrypted
# at rest with WALLET_CONFIG_ENCRYPTION_KEY (set in the env file below),
# which must match the value the main app container uses to encrypt them
# in the first place.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
