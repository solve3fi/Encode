# Must be the exact same value the main app container uses (see the
# deploy compose .env) — wallets are encrypted with it via the Admin UI and
# decrypted with it here. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_CONFIG_ENCRYPTION_KEY=

SOLVE3_RPC_URL=https://api.devnet.solana.com
