[Unit]
Description=Solve3 public auto-vote keeper
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/solve3/public-auto-vote-keeper.env
RuntimeDirectory=solve3-public-auto-vote-keeper
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n -E 75 /run/solve3-public-auto-vote-keeper/lock /usr/bin/docker run --rm --read-only --network host --security-opt no-new-privileges --cap-drop ALL --tmpfs /tmp:rw,noexec,nosuid,size=16m --env-file /etc/solve3/public-auto-vote-keeper.env -v /srv/solve3/scripts:/app/scripts:ro -v /srv/solve3/src/configs/vesolve.json:/app/src/configs/vesolve.json:ro -v /etc/solve3/public-auto-vote-keeper.json:/run/secrets/solve3-public-auto-vote-keeper.json:ro --entrypoint /usr/local/bin/bun solve3-frontend:local /app/scripts/public-auto-vote-keeper.mjs
SuccessExitStatus=75

# Unlike the admin auto-vote wallets keeper, this one derives everything it
# needs (which locks are enrolled, what each already voted) straight from
# on-chain state -- no data volume mount, nothing written back locally. The
# keeper's own keypair pays every enrolled lock's vote() fee and any
# user_vote rent, so it needs its own funded balance (see the .env.example
# for how to check/top it up), separate from the protocol admin key.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
