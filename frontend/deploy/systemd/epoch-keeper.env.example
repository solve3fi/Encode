# Public configuration only. Keep the keypair itself outside the repository.
SOLVE3_KEEPER_KEYPAIR=/run/secrets/solve3-admin-keypair.json
SOLVE3_RPC_URL=https://api.devnet.solana.com
# Optional extra endpoints (comma-separated) tried when the primary rate-limits or fails. Use a private RPC
# as SOLVE3_RPC_URL for the Oct 8 epoch; requests retry with backoff on 429/5xx either way.
# SOLVE3_RPC_FALLBACK_URLS=https://api.devnet.solana.com
# Optional routing/funding allowlist: comma-separated SYMBOL:ADDRESS entries.
# Unset means discover every active gauge in this protocol and DEX config.
# Fee policy ALWAYS covers every pool in the DEX config, including inactive
# gauges and gauges omitted from this list: no/inactive gauge=0%; active native gauge=100%.
# Requires upgraded contracts AND native gauge migration before installing.
# SOLVE3_ACTIVE_GAUGES=BONK3:BUQBUdS93v2yrqG1T6SKdSrDSW7s4KwQT3MYXqBpD1B8,WIF3:6Hqa6TYH4U12MAbktXDMbwAxcjpm7AQQsFrrkviGsSvB,PEPE3:9LcB8K6rWizVSy68uuEYnTNCMR3p62NAkns4YwujmcLb
